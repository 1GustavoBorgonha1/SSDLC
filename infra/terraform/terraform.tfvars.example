aws_region       = "us-east-1"
environment      = "production"
instance_type    = "t3.micro"

# Cole aqui o conteúdo de ~/.ssh/salafacil.pub
ssh_public_key   = "ssh-ed25519 AAAA... aluno@universidade"

# INF-S1 — apenas o seu IP. Descubra com: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.10/32"
