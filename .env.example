# Copie para .env e preencha. NFR-S3: nenhum destes valores vai para o git.

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-valor-por-um-segredo-de-32-ou-mais-caracteres
JWT_TTL_SECONDS=28800

PORT=3000
HOST=0.0.0.0
DATABASE_FILE=./data/salafacil.db
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
APP_VERSION=dev

# Usadas apenas pelo `npm run seed` (SPEC-001 §4).
SEED_ADMIN_PASSWORD=
SEED_PROFESSOR_PASSWORD=
